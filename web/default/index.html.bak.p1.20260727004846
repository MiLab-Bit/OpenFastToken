<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 防首屏闪烁(FOUC)：在 hydration 前根据 cookie 同步设置主题 class 与皮肤属性 -->
    <script>
      (function () {
        try {
          function g(n){var m=document.cookie.match('(^|;)\\s*'+n+'=([^;]+)');return m?m[2]:null;}
          var t=g('vite-ui-theme')||'system';
          var sd=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;
          var r=t==='system'?(sd?'dark':'light'):t;
          var e=document.documentElement;
          e.classList.remove('light','dark');e.classList.add(r);
          // 前向兼容：皮肤轴（P1 起由 skin-provider 写入 vite-ui-skin）
          var s=g('vite-ui-skin');if(s)e.setAttribute('data-skin',s);
        }catch(_){}
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>FastToken</title>
  <style>
    /* Inter + Public Sans: hosted locally at /fonts/ */
    @font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url("/fonts/inter-latin-wght-normal.woff2") format("woff2-variations") technology("variations")}
    @font-face{font-family:"Public Sans Variable";font-style:normal;font-weight:100 900;font-display:swap;src:url("/fonts/public-sans-latin-wght-normal.woff2") format("woff2-variations") technology("variations")}
  </style>

    <meta name="title" content="FastToken" />
    <meta
      name="description"
      content="Unified AI API gateway and admin dashboard."
    />

    <meta name="theme-color" content="#f4f2ed" />
    <!--umami-->
    <!--Google Analytics-->
  </head>

  <body>
    <div id="root"></div>
  </body>
</html>
