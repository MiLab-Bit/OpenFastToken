package router

import (
	"www.abc-ai.cn/FastToken/controller"
	"www.abc-ai.cn/FastToken/middleware"

	_ "www.abc-ai.cn/FastToken/oauth"

	"github.com/gin-contrib/gzip"
	"github.com/gin-gonic/gin"
)

func SetApiRouter(router *gin.Engine) {
	apiRouter := router.Group("/api")
	apiRouter.Use(middleware.RouteTag("api"))
	apiRouter.Use(gzip.Gzip(gzip.DefaultCompression))
	apiRouter.Use(middleware.BodyStorageCleanup())
	apiRouter.Use(middleware.GlobalAPIRateLimit())
	{
		// ==================== Public Routes ====================
		// 通用文件上传（营业执照等合规材料），登录用户可用
		apiRouter.POST("/misc/upload", middleware.UserAuth(), controller.UploadFile)
		apiRouter.GET("/setup", controller.GetSetup)
		apiRouter.POST("/setup", controller.PostSetup)
		apiRouter.GET("/status", controller.GetStatus)
		apiRouter.GET("/payment/status", controller.PaymentStatus)
		apiRouter.GET("/uptime/status", controller.GetUptimeKumaStatus)
		apiRouter.GET("/models", middleware.UserAuth(), controller.DashboardListModels)
		apiRouter.GET("/notice", controller.GetNotice)
		apiRouter.GET("/verification", middleware.EmailVerificationRateLimit(), controller.SendEmailVerification)
		apiRouter.GET("/reset_password", middleware.CriticalRateLimit(), controller.SendPasswordResetEmail)
		apiRouter.POST("/user/reset", middleware.CriticalRateLimit(), controller.ResetPassword)

		// OAuth routes
		apiRouter.GET("/oauth/state", middleware.CriticalRateLimit(), controller.GenerateOAuthCode)
		apiRouter.GET("/oauth/:provider", controller.HandleOAuth)
		apiRouter.GET("/oauth/:provider/callback", controller.HandleOAuth)
		apiRouter.GET("/ratio_config", middleware.CriticalRateLimit(), controller.GetRatioConfig)
		apiRouter.GET("/pricing", middleware.UserAuth(), controller.GetPricing)

		// Phone authentication routes
		phoneRouter := apiRouter.Group("/phone")
		phoneRouter.Use(middleware.CriticalRateLimit())
		{
			phoneRouter.POST("/send_code", controller.PhoneSendCode)
			phoneRouter.POST("/verify_code", controller.PhoneVerifyCode)
			phoneRouter.POST("/register", middleware.CriticalRateLimit(), controller.PhoneRegister)
			phoneRouter.POST("/login", middleware.CriticalRateLimit(), controller.PhoneLogin)
		}

		// Payment callback routes
		apiRouter.POST("/alipay/notify", controller.AlipayNotify)
		apiRouter.POST("/wechat/notify", controller.WechatNotify)
		// 支付宝回跳：用户支付完成后跳回时立即查单入账，再重定向到前端页面（公开 GET）
		apiRouter.GET("/alipay/return", controller.AlipayReturn)

		// User routes (public)
		userRoute := apiRouter.Group("/user")
		{
			userRoute.POST("/register", middleware.CriticalRateLimit(), controller.Register)
			userRoute.POST("/login", middleware.CriticalRateLimit(), controller.Login)
			userRoute.POST("/logout", controller.Logout)
		}

		// Token routes
		tokenRoute := apiRouter.Group("/token")
		tokenRoute.Use(middleware.UserAuth())
		{
			tokenRoute.GET("/", controller.GetAllTokens)
			tokenRoute.GET("/search", controller.SearchTokens)
			tokenRoute.GET("/:id", controller.GetToken)
			tokenRoute.POST("/", controller.AddToken)
			tokenRoute.POST("/:id/key", controller.GetTokenKey)
			tokenRoute.PUT("/", controller.UpdateToken)
			tokenRoute.DELETE("/:id", controller.DeleteToken)
		}

		// Self routes (authenticated user) - basic routes only
		selfRoute := apiRouter.Group("/self")
		selfRoute.Use(middleware.UserAuth())
		{
			// Account binding routes
			selfRoute.GET("/bindings", controller.GetBindings)
			selfRoute.POST("/bind_phone", middleware.CriticalRateLimit(), controller.BindPhone)
			selfRoute.POST("/unbind_phone", middleware.CriticalRateLimit(), controller.UnbindPhone)
			selfRoute.POST("/bind_wechat", controller.BindWeChat)
			selfRoute.POST("/unbind_wechat", controller.UnbindWeChat)
		}

		// User self profile (/api/user/self) — compatibility with frontend
		userSelfRoute := apiRouter.Group("/user/self")
		userSelfRoute.Use(middleware.UserAuth())
		{
			userSelfRoute.GET("", controller.GetSelf)
			userSelfRoute.PUT("", controller.UpdateUser)
			userSelfRoute.DELETE("", controller.DeleteUser)
			userSelfRoute.GET("/2fa/status", controller.Get2FAStatus)
			userSelfRoute.POST("/2fa/setup", controller.Post2FASetup)
			userSelfRoute.POST("/2fa/enable", controller.Post2FAEnable)
			userSelfRoute.POST("/2fa/disable", controller.Post2FADisable)
			userSelfRoute.POST("/2fa/regenerate-backup", controller.Post2FARegenerateBackup)
		}

		// Channel routes (admin)
		channelRoute := apiRouter.Group("/channel")
		channelRoute.Use(middleware.AdminAuth())
		{
			// CRUD
			channelRoute.GET("/", controller.GetAllChannels)
			channelRoute.GET("/search", controller.SearchChannels)
			channelRoute.GET("/models", controller.ChannelListModels)
			channelRoute.GET("/models_enabled", controller.EnabledListModels)
			channelRoute.GET("/:id", controller.GetChannel)
			channelRoute.POST("/", controller.AddChannel)
			channelRoute.PUT("/", controller.UpdateChannel)
			channelRoute.DELETE("/:id", controller.DeleteChannel)
			// Test
			channelRoute.GET("/test", controller.TestAllChannels)
			channelRoute.GET("/test/:id", controller.TestChannel)
			// Balance
			channelRoute.GET("/update_balance", controller.UpdateAllChannelsBalance)
			channelRoute.GET("/update_balance/:id", controller.UpdateChannelBalance)
			// Tag management
			channelRoute.POST("/tag/disabled", controller.DisableTagChannels)
			channelRoute.POST("/tag/enabled", controller.EnableTagChannels)
			channelRoute.PUT("/tag", controller.EditTagChannels)
			channelRoute.POST("/batch/tag", controller.BatchSetChannelTag)
			channelRoute.GET("/tag/models", controller.GetTagModels)
			// Batch operations
			channelRoute.POST("/batch", controller.DeleteChannelBatch)
			channelRoute.DELETE("/disabled", controller.DeleteDisabledChannel)
			// Fix & sync
			channelRoute.POST("/fix", controller.FixChannelsAbilities)
			channelRoute.GET("/fetch_models/:id", controller.FetchUpstreamModels)
			channelRoute.POST("/fetch_models", controller.FetchModels)
			channelRoute.POST("/copy/:id", controller.CopyChannel)
			// Multi-key
			channelRoute.POST("/multi_key/manage", controller.ManageMultiKeys)
			// Upstream model updates
			channelRoute.POST("/upstream_updates/apply", controller.ApplyChannelUpstreamModelUpdates)
			channelRoute.POST("/upstream_updates/apply_all", controller.ApplyAllChannelUpstreamModelUpdates)
			channelRoute.POST("/upstream_updates/detect", controller.DetectChannelUpstreamModelUpdates)
			channelRoute.POST("/upstream_updates/detect_all", controller.DetectAllChannelUpstreamModelUpdates)
		}

		// User membership route (must be before /user/:id to avoid route conflict)
		apiRouter.GET("/user/membership", middleware.UserAuth(), controller.UserGetMembershipInfo)

		// User management routes (admin)
		userAdminRoute := apiRouter.Group("/user")
		userAdminRoute.Use(middleware.AdminAuth())
		{
			userAdminRoute.GET("/", controller.GetAllUsers)
			userAdminRoute.GET("/search", controller.SearchUsers)
			userAdminRoute.GET("/topup", controller.GetAllTopUps)
			userAdminRoute.GET("/:id", controller.GetUser)
			userAdminRoute.PUT("/", controller.UpdateUser)
			userAdminRoute.DELETE("/:id", controller.DeleteUser)
		}

		// Log routes
		logRoute := apiRouter.Group("/log")
		logRoute.Use(middleware.UserAuth())
		{
			logRoute.GET("/", controller.GetAllLogs)
			logRoute.GET("/search", controller.SearchUserLogs)
			logRoute.GET("/:key", controller.GetLogByKey)
		}

		// Usage statistics (self)
		apiRouter.GET("/log/self/stat", middleware.UserAuth(), controller.GetLogsSelfStat)
		apiRouter.GET("/log/self", middleware.UserAuth(), controller.GetUserLogs)

		// Usage statistics (admin)
		apiRouter.GET("/log/stat", middleware.AdminAuth(), controller.GetLogsStat)

		// Option routes (admin)
		optionRoute := apiRouter.Group("/option")
		optionRoute.Use(middleware.AdminAuth())
		{
			optionRoute.GET("/", controller.GetOptions)
			optionRoute.PUT("/", controller.UpdateOption)
			// Channel affinity cache management
			optionRoute.GET("/channel_affinity_cache", controller.GetChannelAffinityCacheStats)
			optionRoute.DELETE("/channel_affinity_cache", controller.ClearChannelAffinityCache)
			// 配置即数据：运行时热加载 / 定价 DB / 本地化 DB / 活动框架
			optionRoute.POST("/reload", controller.ReloadConfig)
			optionRoute.GET("/pricing", controller.GetModelPricings)
			optionRoute.PUT("/pricing", controller.UpdateModelPricing)
			optionRoute.GET("/i18n", controller.ListI18nLocales)
			optionRoute.PUT("/i18n", controller.UpdateI18nMessages)
			optionRoute.GET("/activities", controller.ListActivities)
			optionRoute.POST("/activities", controller.CreateActivity)
			optionRoute.PUT("/activities/:id", controller.UpdateActivity)
			optionRoute.DELETE("/activities/:id", controller.DeleteActivity)
		}

		// Topup routes (admin only — full platform access)
		topupRoute := apiRouter.Group("/topup")
		topupRoute.Use(middleware.AdminAuth())
		{
			topupRoute.GET("/", controller.GetAllTopUps)
			topupRoute.POST("/expire", controller.AdminExpireTopUps)
		}

		// Admin topup complete (requires admin auth)
		apiRouter.POST("/topup/complete", middleware.AdminAuth(), controller.AdminCompleteTopUp)
		// Admin topup refund (requires admin auth)
		apiRouter.POST("/topup/refund", middleware.AdminAuth(), controller.AdminRefundTopUp)
		
		// 配置即数据：公开运行时端点（前端本地化合并 / 充值赠送展示）
		apiRouter.GET("/i18n/messages", controller.GetI18nMessages)
		apiRouter.POST("/topup/gift-bonus", controller.GetTopupGiftBonus)

		// Redemption routes (admin only)
		redemptionRoute := apiRouter.Group("/redemption")
		redemptionRoute.Use(middleware.AdminAuth())
		{
			redemptionRoute.GET("/", controller.GetAllRedemptions)
			redemptionRoute.POST("/", controller.AddRedemption)
			redemptionRoute.PUT("/", controller.UpdateRedemption)
			redemptionRoute.DELETE("/:id", controller.DeleteRedemption)
		}

		// User payment routes
		userPaymentRoute := apiRouter.Group("/user")
		userPaymentRoute.Use(middleware.UserAuth())
		{
			userPaymentRoute.GET("/models", controller.GetUserModels)
			userPaymentRoute.GET("/topup/info", controller.GetTopUpInfo)
			userPaymentRoute.GET("/gifts", controller.GetUserGifts)

			// Admin Gift Management routes (admin only)
			adminGiftRoute := apiRouter.Group("/admin/gifts")
			adminGiftRoute.Use(middleware.AdminAuth())
			{
				adminGiftRoute.GET("/", controller.AdminGetAllGifts)
				adminGiftRoute.POST("/:id/status", controller.AdminUpdateGiftStatus)
			}

			// 支付宝对账：主动查询 pending 订单在支付宝侧真实状态并补单
			apiRouter.POST("/admin/alipay/reconcile", middleware.AdminAuth(), controller.AlipayReconcile)
			apiRouter.POST("/admin/wechat/reconcile", middleware.AdminAuth(), controller.WechatReconcile)

			userPaymentRoute.POST("/topup", controller.TopUp)
			userPaymentRoute.POST("/alipay/amount", controller.RequestAlipayAmount)
			userPaymentRoute.POST("/alipay/pay", controller.RequestAlipayPay)
			userPaymentRoute.POST("/wechat/amount", controller.RequestWechatAmount)
			userPaymentRoute.POST("/wechat/pay", controller.RequestWechatPay)
			userPaymentRoute.GET("/topup/self", controller.GetUserTopUps)
			userPaymentRoute.GET("/wechat/query", controller.QueryWechatOrder)
			userPaymentRoute.GET("/alipay/query", controller.QueryAlipayOrder)
			// Invitation code redemption
			userPaymentRoute.POST("/use_invitation_code", controller.UserUseInvitationCode)
			userPaymentRoute.GET("/aff", controller.GetAffCode)
			userPaymentRoute.POST("/aff_transfer", controller.TransferAffQuota)
		}

		// Payment compliance
		apiRouter.POST("/payment/compliance/confirm", middleware.UserAuth(), controller.ConfirmPaymentCompliance)

		// ==================== WebSocket ====================
		apiRouter.GET("/ws", controller.WebSocketHandler)

		// ==================== Dashboard Data ====================
		apiRouter.GET("/data", middleware.AdminAuth(), controller.GetAllQuotaDates)
		apiRouter.GET("/data/self", middleware.UserAuth(), controller.GetUserQuotaDates)
		apiRouter.GET("/data/users", middleware.AdminAuth(), controller.GetQuotaDatesByUser)
		// ==================== Rankings ====================
		apiRouter.GET("/rankings", controller.GetRankings)

		// ==================== Checkin (authenticated) ====================
		checkinRoute := apiRouter.Group("/checkin")
		checkinRoute.Use(middleware.UserAuth())
		{
			checkinRoute.GET("/status", controller.GetCheckinStatus)
			checkinRoute.POST("/do", controller.DoCheckin)
		}

		// ==================== Performance (admin) ====================
		perfRoute := apiRouter.Group("/perf")
		perfRoute.Use(middleware.AdminAuth())
		{
			perfRoute.GET("/metrics", controller.GetPerfMetrics)
			perfRoute.GET("/metrics/summary", controller.GetPerfMetricsSummary)
			perfRoute.GET("/stats", controller.GetPerformanceStats)
			perfRoute.GET("/stats/reset", controller.ResetPerformanceStats)
			perfRoute.GET("/cache/clear", controller.ClearDiskCache)
			perfRoute.GET("/gc", controller.ForceGC)
			perfRoute.GET("/logs", controller.GetLogFiles)
			perfRoute.POST("/logs/cleanup", controller.CleanupLogFiles)
		}

		// Frontend dashboard compatibility aliases
		apiRouter.GET("/perf-metrics", middleware.UserAuth(), controller.GetPerfMetrics)
		// Performance compatibility aliases for frontend /performance/* paths
		apiRouter.GET("/performance/stats", middleware.AdminAuth(), controller.GetPerformanceStats)
		apiRouter.GET("/performance/logs", middleware.AdminAuth(), controller.GetLogFiles)
		// RESTful compatibility aliases (synced from server deployment)
		apiRouter.POST("/performance/gc", middleware.AdminAuth(), controller.ForceGC)
		apiRouter.POST("/performance/reset_stats", middleware.AdminAuth(), controller.ResetPerformanceStats)
		apiRouter.DELETE("/performance/disk_cache", middleware.AdminAuth(), controller.ClearDiskCache)
		apiRouter.DELETE("/performance/logs", middleware.AdminAuth(), controller.CleanupLogFiles)
		apiRouter.GET("/perf-metrics/summary", middleware.UserAuth(), controller.GetPerfMetricsSummary)

		// ==================== Enterprise (admin) ====================
		enterpriseRoute := apiRouter.Group("/enterprise")
		enterpriseRoute.Use(middleware.AdminAuth())
		{
			enterpriseRoute.GET("/", controller.AdminListEnterprises)
			enterpriseRoute.POST("/", controller.AdminCreateEnterprise)
			enterpriseRoute.POST("/:id/approve", controller.AdminApproveEnterprise)
			enterpriseRoute.POST("/:id/reject", controller.AdminRejectEnterprise)
		}

		// ==================== Custom OAuth Providers (admin) ====================
		customOAuthRoute := apiRouter.Group("/custom-oauth-provider")
		customOAuthRoute.Use(middleware.AdminAuth())
		{
			customOAuthRoute.GET("/", controller.ListCustomOAuthProviders)
			customOAuthRoute.GET("/:id", controller.GetCustomOAuthProvider)
			customOAuthRoute.POST("/", controller.CreateCustomOAuthProvider)
			customOAuthRoute.PUT("/:id", controller.UpdateCustomOAuthProvider)
			customOAuthRoute.DELETE("/:id", controller.DeleteCustomOAuthProvider)
			customOAuthRoute.POST("/discovery", controller.DiscoverOIDCEndpoints)
		}

		// ==================== Ollama (admin) ====================
		ollamaRoute := apiRouter.Group("/ollama")
		ollamaRoute.Use(middleware.AdminAuth())
		{
			ollamaRoute.POST("/pull", controller.OllamaPullModel)
			ollamaRoute.GET("/pull/stream", controller.OllamaPullModelStream)
			ollamaRoute.POST("/delete", controller.OllamaDeleteModel)
			ollamaRoute.GET("/version", controller.OllamaVersion)
		}

		// ==================== Models (admin) ====================
		modelsRoute := apiRouter.Group("/models")
		modelsRoute.Use(middleware.AdminAuth())
		{
			modelsRoute.GET("/", controller.GetAllModelsMeta)
			modelsRoute.GET("/search", controller.SearchModelsMeta)
			modelsRoute.GET("/missing", controller.GetMissingModels)
			modelsRoute.GET("/:id", controller.GetModelMeta)
			modelsRoute.POST("/", controller.CreateModelMeta)
			modelsRoute.PUT("/", controller.UpdateModelMeta)
			modelsRoute.DELETE("/:id", controller.DeleteModelMeta)
			modelsRoute.GET("/sync_upstream/preview", controller.SyncUpstreamPreview)
			modelsRoute.POST("/sync_upstream", controller.SyncUpstreamModels)
		}

		// ==================== Vendors (admin) ====================
		vendorRoute := apiRouter.Group("/vendors")
		vendorRoute.Use(middleware.AdminAuth())
		{
			vendorRoute.GET("/", controller.GetAllVendors)
			vendorRoute.GET("/search", controller.SearchVendors)
			vendorRoute.GET("/:id", controller.GetVendorMeta)
			vendorRoute.POST("/", controller.CreateVendorMeta)
			vendorRoute.PUT("/", controller.UpdateVendorMeta)
			vendorRoute.DELETE("/:id", controller.DeleteVendorMeta)
		}

		// ==================== Group Ratio (admin) ====================
		groupRatioRoute := apiRouter.Group("/group-ratio")
		groupRatioRoute.Use(middleware.AdminAuth())
		{
			groupRatioRoute.GET("/", controller.AdminListGroupRatios)
			groupRatioRoute.POST("/", controller.AdminCreateGroupRatio)
			groupRatioRoute.PUT("/:id", controller.AdminUpdateGroupRatio)
			groupRatioRoute.DELETE("/:id", controller.AdminDeleteGroupRatio)
		}

		// ==================== Enterprise Sub-Users (admin) ====================
		enterpriseSubRoute := apiRouter.Group("/enterprise/:id/users")
		enterpriseSubRoute.Use(middleware.AdminAuth())
		{
			enterpriseSubRoute.GET("/", controller.EnterpriseListUsers)
			enterpriseSubRoute.POST("/", controller.EnterpriseCreateUser)
			enterpriseSubRoute.PUT("/:uid", controller.EnterpriseUpdateUserQuota)
			enterpriseSubRoute.DELETE("/:uid", controller.EnterpriseDeleteUser)
		}

		// ==================== Deployments (admin) ====================
		deploymentsRoute := apiRouter.Group("/deployments")
		deploymentsRoute.Use(middleware.AdminAuth())
		{
			deploymentsRoute.GET("/settings", controller.GetModelDeploymentSettings)
			deploymentsRoute.POST("/settings/test-connection", controller.TestIoNetConnection)
			deploymentsRoute.GET("/", controller.GetAllDeployments)
			deploymentsRoute.GET("/search", controller.SearchDeployments)
			deploymentsRoute.POST("/", controller.CreateDeployment)
			deploymentsRoute.GET("/hardware-types", controller.GetHardwareTypes)
			deploymentsRoute.GET("/locations", controller.GetLocations)
			deploymentsRoute.GET("/available-replicas", controller.GetAvailableReplicas)
			deploymentsRoute.POST("/price-estimation", controller.GetPriceEstimation)
			deploymentsRoute.GET("/check-name", controller.CheckClusterNameAvailability)
			deploymentsRoute.GET("/:id", controller.GetDeployment)
			deploymentsRoute.PUT("/:id", controller.UpdateDeployment)
			deploymentsRoute.PUT("/:id/name", controller.UpdateDeploymentName)
			deploymentsRoute.POST("/:id/extend", controller.ExtendDeployment)
			deploymentsRoute.DELETE("/:id", controller.DeleteDeployment)
			deploymentsRoute.GET("/:id/logs", controller.GetDeploymentLogs)
			deploymentsRoute.GET("/:id/containers", controller.ListDeploymentContainers)
			deploymentsRoute.GET("/:id/containers/:containerId", controller.GetContainerDetails)
		}

		// ==================== Webhook (user) ====================
		webhookRoute := apiRouter.Group("/webhook")
		webhookRoute.Use(middleware.UserAuth())
		{
			webhookRoute.GET("/", controller.GetUserWebhooks)
			webhookRoute.POST("/", controller.CreateUserWebhook)
			webhookRoute.PUT("/:id", controller.UpdateUserWebhook)
			webhookRoute.DELETE("/:id", controller.DeleteUserWebhook)
		}

		// ==================== Passkey (WebAuthn) ====================
		passkeyLoginRoute := apiRouter.Group("/user/passkey/login")
		{
			passkeyLoginRoute.POST("/begin", middleware.CriticalRateLimit(), controller.BeginPasskeyLogin)
			passkeyLoginRoute.POST("/finish", middleware.CriticalRateLimit(), controller.FinishPasskeyLogin)
		}
		passkeyRoute := apiRouter.Group("/user/passkey")
		passkeyRoute.Use(middleware.UserAuth())
		{
			passkeyRoute.GET("", controller.GetPasskeyStatus)
			passkeyRoute.POST("/register/begin", controller.BeginPasskeyRegistration)
			passkeyRoute.POST("/register/finish", controller.FinishPasskeyRegistration)
			passkeyRoute.POST("/verify/begin", controller.BeginPasskeyVerification)
			passkeyRoute.POST("/verify/finish", controller.FinishPasskeyVerification)
			passkeyRoute.DELETE("/:id", controller.DeletePasskey)
			passkeyRoute.DELETE("", controller.DeletePasskey)
		}
	}

	// ==================== Subscription (public / user / admin) ====================
	apiRouter.GET("/subscription/plans", controller.GetSubscriptionPlans)
	apiRouter.GET("/subscription/self", middleware.UserAuth(), controller.GetUserSubscription)
	apiRouter.GET("/subscription/admin/plans", middleware.AdminAuth(), controller.GetSubscriptionPlans)

	// ==================== Groups ====================
	apiRouter.GET("/group/", controller.GetGroups)
	apiRouter.GET("/user/self/groups", middleware.UserAuth(), controller.GetUserGroups)

	// ==================== Prefill Group (admin) ====================
	prefillGroupRoute := apiRouter.Group("/prefill_group")
	prefillGroupRoute.Use(middleware.AdminAuth())
	{
		prefillGroupRoute.GET("/", controller.GetPrefillGroups)
		prefillGroupRoute.POST("/", controller.CreatePrefillGroup)
		prefillGroupRoute.PUT("/", controller.UpdatePrefillGroup)
		prefillGroupRoute.DELETE("/:id", controller.DeletePrefillGroup)
	}

	// ==================== Invitation Codes (admin) ====================
	apiRouter.GET("/user/invitation_codes", middleware.AdminAuth(), controller.AdminListInvitationCodes)
	apiRouter.GET("/user/invitation_code/stats", middleware.AdminAuth(), controller.AdminGetInvitationCodeStats)

	apiRouter.POST("/user/invitation_code", middleware.AdminAuth(), controller.AdminCreateInvitationCode)
	apiRouter.DELETE("/user/invitation_code/:id", middleware.AdminAuth(), controller.AdminDeleteInvitationCode)

	// ==================== Tasks ====================
	apiRouter.GET("/task", middleware.UserAuth(), controller.GetUserTask)
	apiRouter.GET("/task/self", middleware.UserAuth(), controller.GetUserTask)

	// ==================== Home Page Content ====================
	apiRouter.GET("/home_page_content", controller.GetHomePageContent)

	// ==================== About / Legal (public) ====================
	apiRouter.GET("/about", controller.GetAbout)
	apiRouter.GET("/user-agreement", controller.GetUserAgreement)
	apiRouter.GET("/privacy-policy", controller.GetPrivacyPolicy)

	// ==================== 2FA Status ====================
	apiRouter.GET("/two_factor/status", middleware.UserAuth(), controller.GetTwoFAStatus)

	// ==================== Ratio Sync (admin) ====================
	apiRouter.GET("/ratio_sync/channels", middleware.AdminAuth(), controller.GetSyncableChannels)
	apiRouter.POST("/ratio_sync/fetch", middleware.AdminAuth(), controller.FetchUpstreamRatios)
	// ===== CSV 导出端点 =====
	enterpriseExportRoute := apiRouter.Group("/enterprise")
	enterpriseExportRoute.Use(middleware.RootAuth())
	enterpriseExportRoute.GET("/export", controller.ExportEnterprises)

	redemptionExportRoute := apiRouter.Group("/redemption")
	redemptionExportRoute.Use(middleware.RootAuth())
	redemptionExportRoute.GET("/export", controller.ExportRedemptions)

	adminGiftExportRoute := apiRouter.Group("/admin/gifts")
	adminGiftExportRoute.Use(middleware.RootAuth())
	adminGiftExportRoute.GET("/export", controller.ExportGifts)

	tokenExportRoute := apiRouter.Group("/token")
	tokenExportRoute.Use(middleware.RootAuth())
	tokenExportRoute.GET("/export", controller.ExportTokens)

	logSelfExportRoute := apiRouter.Group("/log")
	logSelfExportRoute.Use(middleware.UserAuth())
	logSelfExportRoute.GET("/self/export", controller.ExportUserLogs)

	logAllExportRoute := apiRouter.Group("/log")
	logAllExportRoute.Use(middleware.AdminAuth())
	logAllExportRoute.GET("/export", controller.ExportAllLogs)

	taskSelfExportRoute := apiRouter.Group("/task")
	taskSelfExportRoute.Use(middleware.UserAuth())
	taskSelfExportRoute.GET("/self/export", controller.ExportUserTasks)

	taskAllExportRoute := apiRouter.Group("/task")
	taskAllExportRoute.Use(middleware.AdminAuth())
	taskAllExportRoute.GET("/export", controller.ExportAllTasks)
}
